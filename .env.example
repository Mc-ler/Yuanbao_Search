# Yuanbao Search (standard)
# Store the raw service key. The application adds exactly one "Bearer " prefix
# when building the Authorization header, even if the value already has one.
SEARCH_PROVIDER=api
SEARCH_API_KEY=
SEARCH_BASE_URL=https://api.wsa.cloud.tencent.com

# LLM providers (GPT/Codex through the third-party Toklens supplier).
# config/llm_providers.json defines routing; these values hold the keys.
LLM_PROVIDER=gpt
TOKLENS_API_KEY=
GPT_BASE_URL=https://lax.toklens.ai/v1
GPT_API_KEY=
CODEX_BASE_URL=https://lax.toklens.ai/v1
CODEX_API_KEY=

# Legacy single-provider fallback (used if the provider registry has no keys)
LLM_BASE_URL=https://lax.toklens.ai/v1
LLM_API_KEY=
LLM_MODEL=

# Server
APP_HOST=127.0.0.1
APP_PORT=8000
APP_API_TOKEN=

# Budgets and limits (canonical: 4 / 28 / 400)
MAX_CALLS_PER_ASSERTION=4
MAX_CALLS_PER_RUN=28
MAX_CALLS_PER_DAY=400
RUN_WALL_SECONDS=90
DEDUP_THRESHOLD=0.65
CACHE_TTL_HOURS=72
MAX_CONCURRENT_RESEARCH=2

# Evidence screenshots: best-effort headless Chrome; leave empty to auto-detect
EVIDENCE_SCREENSHOTS=true
SCREENSHOT_CHROME=
SCREENSHOT_MAX=3
SCREENSHOT_TIMEOUT_MS=8000

# Non-binding LLM advisory for R5 (insufficient) claims
LLM_ADVISORY=true

# Tests may force the deterministic fake search provider
ALLOW_FAKE_SEARCH=false

# Offline replay: true means cache-only, no network calls
OFFLINE=false

# Local logs (logs/ is gitignored; README.md is tracked)
LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
