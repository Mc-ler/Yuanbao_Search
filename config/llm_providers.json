{
  "version": 1,
  "default_provider": "deepseek",
  "providers": {
    "gpt": {
      "label": "GPT via Toklens (third-party supplier)",
      "base_url": "https://lax.toklens.ai/v1",
      "base_url_env": "GPT_BASE_URL",
      "api_key_env": "GPT_API_KEY",
      "fallback_key_env": "TOKLENS_API_KEY",
      "preferred_models": [
        "gpt-5.6-sol",
        "gpt-5.6-luna",
        "gpt-6-sol",
        "gpt-5.6-terra",
        "gpt-6-astra"
      ],
      "default_model": "gpt-5.6-sol",
      "vision": true
    },
    "codex": {
      "label": "Codex via Toklens (third-party supplier)",
      "base_url": "https://lax.toklens.ai/v1",
      "base_url_env": "CODEX_BASE_URL",
      "api_key_env": "CODEX_API_KEY",
      "fallback_key_env": "TOKLENS_API_KEY",
      "preferred_models": [
        "codex-auto-review",
        "gpt-5.6-sol",
        "gpt-6.1-sol",
        "gpt-5.6-luna",
        "gpt-6-astra",
        "gpt-6-sol",
        "gpt-6-luna"
      ],
      "default_model": "gpt-5.6-sol",
      "vision": true
    },
    "deepseek": {
      "label": "DeepSeek (official OpenAI-compatible)",
      "base_url": "https://api.deepseek.com/v1",
      "base_url_env": "DEEPSEEK_BASE_URL",
      "api_key_env": "DEEPSEEK_API_KEY",
      "preferred_models": [
        "deepseek-chat",
        "deepseek-reasoner"
      ],
      "default_model": "deepseek-chat",
      "timeout_seconds": 90,
      "vision": false,
      "legacy_key": false
    }
  },
  "task_routes": {
    "extract_claims": "deepseek",
    "match_evidence": "deepseek",
    "report": "deepseek",
    "decompose_requirements": "deepseek",
    "build_queries": "deepseek",
    "answer": "deepseek",
    "advisory": "deepseek",
    "deepseek_probe": "deepseek",
    "code": "codex"
  },
  "task_models": {}
}
