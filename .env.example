# Yuanbao Search (standard)
# Store the raw service key. The application adds exactly one "Bearer " prefix
# when building the Authorization header, even if the value already has one.
SEARCH_PROVIDER=api
SEARCH_API_KEY=
SEARCH_BASE_URL=https://api.wsa.cloud.tencent.com

# LLM providers. DeepSeek is the recommended stable default; GPT/Codex via
# Toklens are kept as optional fallbacks. config/llm_providers.json defines
# routing, preferred models and per-provider timeouts.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Explicit model override; empty = provider preferred/default
LLM_MODEL=deepseek-flash
# GPT/Codex/Toklens providers remain available in config/llm_providers.json;
# leave their keys empty to disable them without removing the integration.
TOKLENS_API_KEY=
GPT_BASE_URL=https://lax.toklens.ai/v1
GPT_API_KEY=
CODEX_BASE_URL=https://lax.toklens.ai/v1
CODEX_API_KEY=

# Server
APP_HOST=127.0.0.1
APP_PORT=8000
APP_API_TOKEN=

# Budgets and limits (canonical: 4 / 28 / 400)
MAX_CALLS_PER_ASSERTION=4
MAX_CALLS_PER_RUN=28
MAX_CALLS_PER_DAY=400
RUN_WALL_SECONDS=90
# Hard cap for a single /api/research request (plan + search + screenshots)
RESEARCH_TIMEOUT_SECONDS=180
# Deep-research density (claim verification keeps 4/28/90)
RESEARCH_QUERIES_PER_REQUIREMENT=5
RESEARCH_MAX_QUERIES_PER_RUN=18
RESEARCH_RESULTS_PER_QUERY=20
RESEARCH_REQUERY_ROUNDS=1
RESEARCH_MAX_CALLS_PER_REQUIREMENT=12
RESEARCH_MAX_CALLS_PER_RUN=48
RESEARCH_WALL_SECONDS=120
RESEARCH_TIME_TRAVERSAL_ROUNDS=2
RESEARCH_TIME_TRAVERSAL_QUERIES=2
# LLM relevance reranking: top candidates per requirement, 0-1 threshold
RERANK_ENABLED=true
RERANK_TOP_N=30
RERANK_THRESHOLD=0.5
# Best-effort full-text fetch for public A/B pages; failures degrade to snippets
CONTENT_FETCH_ENABLED=true
CONTENT_FETCH_MAX_PAGES=3
CONTENT_FETCH_TIMEOUT_SECONDS=8
DEDUP_THRESHOLD=0.65
CACHE_TTL_HOURS=72
MAX_CONCURRENT_RESEARCH=2

# Evidence screenshots: best-effort headless Chrome; leave empty to auto-detect
EVIDENCE_SCREENSHOTS=true
SCREENSHOT_CHROME=
SCREENSHOT_MAX=3
SCREENSHOT_TIMEOUT_MS=8000

# Non-binding LLM advisory for R5 (insufficient) claims
LLM_ADVISORY=true

# Tests may force the deterministic fake search provider
ALLOW_FAKE_SEARCH=false

# Offline replay: true means cache-only, no network calls
OFFLINE=false

# Local logs (logs/ is gitignored; README.md is tracked)
LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
